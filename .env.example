# Rename this file to ".env" (just .env, no .example), then leave the node's
# api_key field blank.
#
# Every value below is a placeholder. Never commit or share a filled-in .env.

# ---------------------------------------------------------------------------
# Required: BytePlus ModelArk key for video generation.
# ---------------------------------------------------------------------------
BYTEPLUS_API_KEY=ark-REPLACE_WITH_YOUR_KEY

# ---------------------------------------------------------------------------
# AI MediaKit nodes ("BytePlus AI MediaKit"): their own API key, created in the
# AI MediaKit console > Settings > API key. NOT the ark- key above.
# ---------------------------------------------------------------------------
BYTEPLUS_MEDIAKIT_API_KEY=REPLACE_WITH_YOUR_MEDIAKIT_KEY

# ---------------------------------------------------------------------------
# Seed Audio 1.0 node: its own key too (BytePlus console > Voice > activate
# "Seed-Audio 1.0" > API key). Seedream uses BYTEPLUS_API_KEY above.
# ---------------------------------------------------------------------------
BYTEPLUS_SEED_AUDIO_API_KEY=REPLACE_WITH_YOUR_SEED_AUDIO_KEY

# ---------------------------------------------------------------------------
# Needed only for reference VIDEO / AUDIO inputs, and for "Upload to Asset
# Library". Those files are uploaded to your TOS bucket and passed to the model
# as presigned URLs. Without AK/SK/REGION/ENDPOINT, video and audio inputs are
# refused (text, images and frame mode still work).
#
# These are BytePlus account access keys from IAM key management - NOT the
# ark- API key above. The Assets API uses the same pair.
# ---------------------------------------------------------------------------
ARK_ACCESS_KEY=REPLACE_WITH_YOUR_ACCESS_KEY
ARK_SECRET_KEY=REPLACE_WITH_YOUR_SECRET_KEY
TOS_REGION=ap-southeast-1
TOS_ENDPOINT=https://tos-ap-southeast-1.bytepluses.com

# Bucket is optional. If omitted, defaults to "comfy-tos-bucket".
# The node creates the bucket automatically if it does not exist.
# Name rules: lowercase letters/numbers/hyphens only (no uppercase/underscores).
TOS_BUCKET=comfy-tos-bucket

# The legacy TOS_ACCESS_KEY / TOS_SECRET_KEY names still work as a fallback if
# you have an older .env:
# TOS_ACCESS_KEY=REPLACE_WITH_YOUR_ACCESS_KEY
# TOS_SECRET_KEY=REPLACE_WITH_YOUR_SECRET_KEY

# ---------------------------------------------------------------------------
# Optional tuning. Uncomment only if you need to change a default.
# ---------------------------------------------------------------------------
# Seconds to wait for an uploaded asset to reach Status=Active (default 600).
# ARK_ASSET_TIMEOUT=600

# Seconds allowed for the create-task request, which also covers uploading a
# large inline reference image over a slow link (default 300).
# ARK_CREATE_TIMEOUT=300

# Asset library placement. Assets default to the "default" project; set this to
# the project your API key runs in if they differ.
# ARK_ASSET_PROJECT=default
# ARK_ASSET_GROUP_NAME=comfyui-seedance
# ARK_ASSET_GROUP_ID=

# Assets OpenAPI endpoint overrides (normally auto-detected).
# ARK_OPENAPI_REGION=ap-southeast-1
# ARK_OPENAPI_HOST=
